# Read by `pnpm build` / `pnpm pages:deploy` (Vite's default production mode). Points at the
# deployed relay Worker (relay/wrangler.jsonc `name`). Not a secret: this is a public connection
# address, so both .env.* files are committed. If the relay is deployed under a different
# workers.dev subdomain, update this line before deploying.
VITE_PREVIEW_RELAY_URL=wss://webmcp-storymaker-preview-relay.webmcp-storymaker.workers.dev
