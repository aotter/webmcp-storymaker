{
  // The type environment for Node tooling scripts (scripts/, vite.config.ts): has node types, no
  // DOM. The environment for browser source is in tsconfig.json; package.json's typecheck runs each
  // one once.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["scripts", "vite.config.ts"]
}
