{
  "name": "webmcp-storymaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-local story workshop where a human and an AI agent co-write a children's story via WebMCP. The story is kept only on the creator's device; a phone preview is relayed over an encrypted connection, never persisted in the cloud.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:boundary": "tsx scripts/check-boundary.ts",
    "check": "pnpm typecheck && pnpm check:boundary",
    "test": "vitest run",
    "test:workspace": "vitest run --passWithNoTests \"workspace.test.ts\"",
    "test:webmcp": "vitest run --passWithNoTests \"webmcp.test.ts\"",
    "smoke:build": "vite build && tsx scripts/smoke-build.ts",
    "relay:dev": "pnpm --dir relay dev",
    "relay:test": "pnpm --dir relay test",
    "relay:deploy": "pnpm --dir relay exec wrangler deploy",
    "pages:deploy": "pnpm build && pnpm exec wrangler pages deploy dist --project-name webmcp-storymaker"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@panzoom/panzoom": "4.6.2",
    "qrcode-generator": "2.0.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
