{
  // Types for the Workers runtime environment: no DOM (this code runs in workerd, not a browser).
  // Workers-specific globals like WebSocket/Request/Response/DurableObject come from
  // worker-configuration.d.ts -- generated by `pnpm types` (= `wrangler types`) from wrangler.jsonc,
  // containing the full workerd runtime types plus an Env interface specific to this binding
  // combination. This is wrangler's currently recommended approach (replacing the older
  // @cloudflare/workers-types package -- wrangler 4.128 prints exactly this migration suggestion
  // when you run `wrangler types`).
  //
  // This generated file is **deliberately not committed** (see .gitignore) -- `pnpm typecheck`/
  // `pnpm test` both automatically run `pnpm types` to regenerate it before running, so it's always
  // in sync with wrangler.jsonc without anyone needing to remember to update it manually. This
  // differs from how the main repo commits certain generated files the way it commits a lockfile --
  // the reason is that this file contains types for the entire Cloudflare platform's API surface
  // (not just the small handful of bindings this app actually uses), and it's full of third-party
  // terminology that has nothing to do with this project's scope. Not committing it keeps the
  // repo small and is also closer to wrangler's own official recommendation.
  //
  // Deliberately excludes the "dom" lib -- so that if a browser-only API not available in workerd
  // (e.g. window) is ever used by accident, this fails red immediately.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test", "worker-configuration.d.ts", "../src/preview/protocol.ts", "../src/preview/snapshot.ts"]
}
