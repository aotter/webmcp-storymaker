{
  // The type environment for browser source only: just DOM + vite/client, with "no" node types --
  // src/** using a Node global like Buffer/process must fail typecheck immediately, complementing
  // check-boundary's import scan; together the two form the fail-closed dependency boundary (see
  // docs/architecture.md). The type environment for Node scripts (scripts/, vite.config.ts) is in
  // tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
